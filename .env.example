# ---- Supabase → Project Settings → API ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Optional (server only, never exposed to browser). Used by /api/contact.
# If you skip it, the anon key is used and RLS allows inserts into contact_messages.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Supabase → Project Settings → Database → Connection string → URI ----
# Only used by deploy.bat / `npm run db:setup` to create tables + seed data. Never sent to Vercel.
# Use the "Session pooler" URI (port 5432) and put your DB password in place of [YOUR-PASSWORD].
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
